# Variables de Captive Center en el servidor (/opt/captive/.env). Copia este archivo a .env y
# llénalo con los valores del proyecto Supabase y de MapTiler. Nunca lo subas a git.
#
# NO pongas aquí NODUS_ALLOW_DB_RESET, NODUS_DEV_PROJECT_REF ni NODUS_PROD_PROJECT_REF: son las que
# permiten vaciar la base (seed, demo y pruebas) y en producción deben faltar.

# Dominio público, sin "/" final. Lo usan la metadata, el sitemap y robots.txt.
NEXT_PUBLIC_SITE_URL=https://captivecenter.nodus.mx

# Supabase → Connect → Transaction pooler (6543) y Session pooler (5432).
DATABASE_URL=
DIRECT_URL=

# Supabase → Settings → API y API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler → Keys.
NEXT_PUBLIC_MAPTILER_KEY=
MAPTILER_API_KEY=

# Opcionales: WhatsApp de soporte (solo dígitos con lada).
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_CAPTIVE_WHATSAPP=
