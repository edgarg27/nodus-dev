# Proyecto Supabase SOLO para pruebas (`pnpm test` y `pnpm test:e2e`). Copia este archivo a .env.test
# y llena los valores desde el dashboard del proyecto de pruebas (p. ej. "nodus-test"). Nunca
# commitees .env.test con valores reales.
#
# Por qué existe: las pruebas vacían las tablas y borran usuarios de Auth. Antes corrían contra
# nodus-dev y se llevaban las cuentas (admins incluidos) y publicaciones del equipo. Ahora la guardia
# (assertSafeToResetTests en src/lib/db/dev-guard.ts) se niega a correr si estas conexiones apuntan a
# nodus-dev o a producción.
#
# Lo que no está aquí (MapTiler, NODUS_DEV_PROJECT_REF, NODUS_PROD_PROJECT_REF…) se toma de .env.
# Primera vez, o tras una migración nueva: pnpm test:db:setup (migraciones + bucket de fotos).

# Connect → Transaction pooler (puerto 6543).
DATABASE_URL=
# Connect → Session pooler (puerto 5432).
DIRECT_URL=
# Settings → API y Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NODUS_ALLOW_DB_RESET=yes
# Project ref del proyecto de pruebas (el identificador de su URL). Debe ser distinto del de nodus-dev.
NODUS_TEST_PROJECT_REF=
