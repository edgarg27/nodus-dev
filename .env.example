# Copia este archivo a .env y llena los valores. Nunca commitees .env con valores reales.
#
# NO hay Docker ni Supabase CLI: desarrollo y pruebas corren contra el proyecto Supabase alojado
# `nodus-dev` (blueprint.md §10, "Prerrequisitos manuales"). Los valores salen del dashboard de ese
# proyecto. Producción usa los mismos nombres con los valores del proyecto `nodus-prod`.

# Botón "Connect" del proyecto → "Transaction pooler" (puerto 6543, usuario postgres.<ref>).
# Conexión de runtime de la app y de las pruebas — src/lib/db/client.ts (prepare: false, obligatorio:
# el modo transacción no soporta sentencias preparadas).
DATABASE_URL=

# Botón "Connect" → "Session pooler" (puerto 5432, usuario postgres.<ref>). Migraciones de
# drizzle-kit y scripts (make-admin). El nombre es histórico: NO es la conexión directa, que es solo
# IPv6 sin el add-on IPv4 (blueprint.md §10 Gotcha #9).
DIRECT_URL=

# Settings → API (Project URL) y Settings → API Keys (publishable key). Son públicas: llegan al
# navegador (por eso llevan el prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API Keys → secret key. Secreto de servidor — nunca se expone al cliente. Lo usan los
# fixtures de Auth de las pruebas, el cliente admin (fotos) y scripts/setup-storage.ts.
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler account → Keys (https://cloud.maptiler.com/account/keys/). La pública (NEXT_PUBLIC_*)
# llega al navegador para el mapa (MapLibre GL JS); restríngela por dominio en el dashboard de
# MapTiler. El servidor usa la suya para el proxy de geocodificación (query param key=).
NEXT_PUBLIC_MAPTILER_KEY=
MAPTILER_API_KEY=

# --- Guardia de la base compartida (src/lib/db/dev-guard.ts) — SOLO en el .env de desarrollo ---
# Los truncados de las pruebas y el seed rechazan correr sin estas tres. NUNCA las definas en Vercel
# ni en ningún ambiente de producción.
# Debe valer exactamente "yes".
NODUS_ALLOW_DB_RESET=yes
# Project ref de nodus-dev (el identificador de la URL del dashboard). DATABASE_URL, DIRECT_URL y
# NEXT_PUBLIC_SUPABASE_URL deben contenerlo.
NODUS_DEV_PROJECT_REF=
# Opcional hasta que exista nodus-prod: project ref de producción. Si está definido, ninguna cadena
# de conexión puede contenerlo (segunda red de seguridad).
NODUS_PROD_PROJECT_REF=
